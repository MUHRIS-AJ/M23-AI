# ─── Database ───────────────────────────────────────────────
# SQLite local file (default). Swap to a Postgres URL later with no code change.
DATABASE_URL="file:./dev.db"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────
# Generate with:  npx auth secret    (or)   openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_BASE64"
# Base URL of the app (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional — leave blank to disable) ───────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ─── API key encryption ─────────────────────────────────────
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"

# ─── First admin (created by the seed script) ───────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"
